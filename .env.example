# ─── MySQL (Honeycoffee inventory + orders) ──────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brew_db
DB_SSL=false

# ─── Inbound EDI webhook (Sermacrops supplier) ───────────────────────
MY_INBOUND_TOKEN=test

# ─── TAPAT Hub integration (PWD/Senior discount) ─────────────────────
# Local dev: leave default. Production: point at the deployed Hub URL.
TAPAT_HUB_URL=http://localhost:3002

# Identifiers registered with the TAPAT Hub (already provisioned).
TAPAT_ESTABLISHMENT_ID=TP-EST-COFFEE-001
TAPAT_TERMINAL_ID=TERM-COFFEE-001
TAPAT_RECEIVER_ID=TP-001
